# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_discord_channel_id

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Auth (REQUIRED - generate with: openssl rand -base64 32)
JWT_SECRET=your-random-secret-key-here

# Cloudflare Turnstile CAPTCHA (REQUIRED - get from https://dash.cloudflare.com/turnstile)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Trakteer (optional - for donation leaderboard)
TRAKTEER_API_KEY=your-trakteer-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://cloudvault.my.id
FILE_SIZE_THRESHOLD=52428800
